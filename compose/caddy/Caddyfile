{
	email {$ACME_EMAIL}
}

{$APP_HOSTNAME} {
	header Strict-Transport-Security "max-age=31536000"

	@i18n path /i18n/*
	header @i18n >Cache-Control "no-cache"

	@api path /api/* /ws/* /actuator/health /actuator/health/* /api-docs /api-docs/* /swagger-ui.html /swagger-ui/*

	handle @api {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:80 {
			header_down Permissions-Policy "camera=(), microphone=(self), display-capture=(self), geolocation=()"
		}
	}
}

import /etc/caddy/redirects*.caddy

#!/usr/bin/env bash
set -euo pipefail
umask 077
{% set backup_aws_opts = '--region ' ~ backup_s3_region ~ (' --endpoint-url ' ~ backup_s3_endpoint_url if backup_s3_endpoint_url | length > 0 else '') %}
{% if backup_s3_bucket | length > 0 and backup_s3_endpoint_url | length > 0 %}

set -a
# shellcheck disable=SC1091
. {{ backup_s3_credentials_file }}
set +a
{% endif %}

cd {{ backup_app_dir }}

stamp="$(date -u +%Y%m%dT%H%M%SZ)"
target="{{ backup_dir }}/reqsai-${stamp}.dump"
partial="${target}.partial"
trap 'rm -f "${partial}"' EXIT

docker compose exec -T db sh -c 'pg_dump --username="$POSTGRES_USER" --dbname="$POSTGRES_DB" --format=custom --compress=6' > "${partial}"
mv "${partial}" "${target}"
echo "Wrote ${target} ($(du -h "${target}" | cut -f1))"

find {{ backup_dir }} -maxdepth 1 -type f -name 'reqsai-*.dump' -printf '%T@ %p\n' \
  | sort -rn | tail -n +{{ (backup_keep | int) + 1 }} | cut -d' ' -f2- | xargs -r rm -f --
{% if backup_s3_bucket | length > 0 %}

/snap/bin/aws s3 cp "${target}" "s3://{{ backup_s3_bucket }}/{{ backup_s3_prefix }}/$(basename "${target}")" \
  {{ backup_aws_opts }} --only-show-errors
echo "Uploaded to s3://{{ backup_s3_bucket }}/{{ backup_s3_prefix }}/$(basename "${target}")"
{% endif %}

aws_region                   = "us-east-1"
environment                  = "mvp"
instance_type                = "t3.small"
root_volume_size             = 30
cpu_credits                  = "standard"
ssh_public_key_path          = "~/.ssh/id_ed25519.pub"
admin_cidrs                  = []
enable_ssm                   = true
dns_zone_name                = "tamci.app"
dns_record_name              = "mvp"
enable_backup_bucket         = false
backup_bucket_retention_days = 30
enable_ecr_pull              = false
termination_protection       = true
github_deploy_repository     = "Kntro-Soft/reqsai-infra"
github_deploy_environment    = "mvp"
github_oidc_provider_arn     = ""
